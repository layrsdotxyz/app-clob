[Unit]
Description=Layrs opening epoch direct-execution Nitro enclave
After=nitro-enclaves-allocator.service
Requires=nitro-enclaves-allocator.service
Before=layrs-opening-parent.service

[Service]
Type=oneshot
RemainAfterExit=yes
# An EIF does not inherit systemd environment variables.  Isolated-only key
# release is performed once over the existing VSOCK channel by the parent.
# The image contains no key material.
ExecStart=/usr/bin/nitro-cli run-enclave --cpu-count 2 --memory 8192 --eif-path /opt/layrs-opening/layrs-direct-execution.eif --enclave-cid 16
ExecStop=/usr/bin/nitro-cli terminate-enclave --all
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
