[Unit]
Description=Layrs opening epoch direct-execution parent
After=layrs-opening-enclave.service
Requires=layrs-opening-enclave.service
# The parent retries indefinitely; a stale enclave is recreated below rather
# than counted against a start limit.
StartLimitIntervalSec=0

[Service]
Type=simple
User=layrsopening
Environment=PORT=8443
Environment=LAYRS_ENCLAVE_CID=16
Environment=LAYRS_OPENING_EPOCH_PATH=/opt/layrs-opening/OPENING_EPOCH_STATE_20260911.json
Environment=LAYRS_OPENING_EVIDENCE_PATH=/opt/layrs-opening/OPENING_EPOCH_EVIDENCE_MANIFEST_20260911.json
# Isolated, write-once encrypted successor-artifact mount.  The protected ACK
# key is injected only at isolated-test/activation time through EnvironmentFile.
Environment=LAYRS_DIRECT_ARTIFACT_DIR=/var/lib/layrs-opening-artifacts
# The root-owned BFF session key is intentionally absent from the AMI.
EnvironmentFile=-/etc/layrs-opening/direct-runtime.env
ExecStart=/opt/layrs-opening/layrs-direct-parent
# Exit status 3 means the enclave still holds a previous parent's grant or
# recovered state.  Recreate the enclave (terminate + run) as root before the
# automatic restart, so the next parent start bootstraps a fresh enclave
# instead of looping on GOVERNED_BOOTSTRAP_REPLAY_MISMATCH.
ExecStopPost=+/bin/sh -c 'if [ "$EXIT_STATUS" = "3" ]; then echo ENCLAVE_RESET_FOR_STALE_STATE; /usr/bin/systemctl restart layrs-opening-enclave.service; fi'
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=
StateDirectory=layrs-opening-artifacts

[Install]
WantedBy=multi-user.target
