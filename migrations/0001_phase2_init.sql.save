CREATE TABLE IF NOT EXISTS users (
    user_id UUID PRIMARY KEY,
    starknet_address VARCHAR(66) UNIQUE,
    proxy_address VARCHAR(66),
    created_at TIMESTAMP NOT NULL DEFAULT NOW()
);

