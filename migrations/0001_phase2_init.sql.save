 export AWS_PROFILE=layrs && aws ecs describe-tasks --cluster layrs --tasks "arn:aws:ecs:us-east-1:255638996474:task/layrs/b5d78404b78b4b38bcf88602f0aabc7e" --region us-east-1 --output json 2>&1 | python3 -c "
import json,sys
d=json.load(sys.stdin)
c=d['tasks'][0]['containers'][0]
print('exit:', c.get('exitCode'))
print('reason:', c.get('reason'))
t=d['tasks'][0]
print('stopped:', t.get('stoppedReason'))
print('log config:', t['taskDefinitionArn'])
"
 AWS_PAGER="" AWS_PROFILE=layrs aws ecs describe-tasks --no-cli-pager --cluster layrs --tasks "arn:aws:ecs:us-east-1:255638996474:task/layrs/b5d78404b78b4b38bcf88602f0aabc7e" --region us-east-1 --output json | python3 -c "
import json,sys
d=json.load(sys.stdin)
c=d['tasks'][0]['containers'][0]
print('exit:', c.get('exitCode'))
print('reason:', c.get('reason'))
t=d['tasks'][0]
print('stopped:', t.get('stoppedReason'))
