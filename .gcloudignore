# This file specifies files that should *not* be uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore, with the addition of
# "#!include" directives (which insert the entries of the given .gitignore-style
# file at that point).

# Default ignores
.gcloudignore
.git
.gitignore

# Development files
*.md
!README.md
target/
*.sh
.env
.env.*
!.env.example

# Test and documentation files
*_test.sh
*TEST*.md
*SUMMARY*.md
*INTEGRATION*.md
*DEPLOYMENT*.md
*ARCHITECTURE*.md
*COMPLETE*.md
*GUIDE*.md

# Keep essential build files
!Cargo.toml
!Cargo.lock
!Dockerfile
!src/
