FROM public.ecr.aws/docker/library/node@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS builder

ARG RUST_TOOLCHAIN=1.94.1
ARG RISC0_RUST_TOOLCHAIN=1.97.0
ARG RISC0_VERSION=2.2.0

ENV PATH=/root/.cargo/bin:/root/.risc0/bin:${PATH}
WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
    && curl -L --proto '=https' --tlsv1.2 https://risczero.com/install \
      | bash \
    && test "$(sha256sum /root/.risc0/bin/rzup | cut -d' ' -f1)" \
      = "7cdc1dd5d4b8ef38ea6170c45bd29ba65d389f0e96b365da61631d1fc5c6c1ca" \
    && rzup install rust "${RISC0_RUST_TOOLCHAIN}" \
    && rzup install r0vm "${RISC0_VERSION}" \
    && rzup install cargo-risczero "${RISC0_VERSION}"

COPY proofs/settlement ./proofs/settlement
RUN cargo build --locked --release \
      --manifest-path proofs/settlement/host/Cargo.toml \
    && npm ci --omit=dev --ignore-scripts \
      --prefix proofs/settlement/worker \
    && npm ci --omit=dev --ignore-scripts \
      --prefix proofs/settlement/zkverify

FROM public.ecr.aws/docker/library/node@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS runtime

ENV NODE_ENV=production \
    RISC0_HOME=/opt/risc0 \
    PATH=/opt/risc0/bin:${PATH}
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1001 proof-worker

COPY --from=builder --chown=1001:1001 /root/.risc0 /opt/risc0
COPY --from=builder --chown=1001:1001 /build/proofs/settlement/target/release/layrs-settlement-proof-host /app/bin/layrs-settlement-proof-host
COPY --from=builder --chown=1001:1001 /build/proofs/settlement/worker/node_modules /app/worker/node_modules
COPY --from=builder --chown=1001:1001 /build/proofs/settlement/worker/core.mjs /app/worker/core.mjs
COPY --from=builder --chown=1001:1001 /build/proofs/settlement/worker/production.mjs /app/worker/production.mjs
COPY --from=builder --chown=1001:1001 /build/proofs/settlement/zkverify/node_modules /app/zkverify/node_modules
COPY --from=builder --chown=1001:1001 /build/proofs/settlement/zkverify/submit-proof.mjs /app/zkverify/submit-proof.mjs
USER proof-worker

ENTRYPOINT ["node", "/app/worker/production.mjs"]
