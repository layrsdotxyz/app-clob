FROM public.ecr.aws/docker/library/node@sha256:1c78323e27e7aff8ac92377845119cd52ac3d3b22e197b3b14e8eb64af387f8c AS builder

ARG RUST_TOOLCHAIN=1.94.1
ARG RISC0_RUST_TOOLCHAIN=1.97.0
ARG RISC0_VERSION=2.2.0

ENV PATH=/root/.cargo/bin:/root/.risc0/bin:${PATH}
WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
    && curl -L --proto '=https' --tlsv1.2 https://risczero.com/install \
      | bash \
    && test "$(sha256sum /root/.risc0/bin/rzup | cut -d' ' -f1)" \
      = "7cdc1dd5d4b8ef38ea6170c45bd29ba65d389f0e96b365da61631d1fc5c6c1ca" \
    && rzup install rust "${RISC0_RUST_TOOLCHAIN}" \
    && rzup install r0vm "${RISC0_VERSION}" \
    && rzup install cargo-risczero "${RISC0_VERSION}"

COPY proofs/settlement ./proofs/settlement
RUN cargo build --locked --release \
      --manifest-path proofs/settlement/host/Cargo.toml \
    && npm ci --omit=dev --ignore-scripts \
      --prefix proofs/settlement/worker \
    && npm ci --omit=dev --ignore-scripts \
      --prefix proofs/settlement/zkverify
RUN apt-get update \
    && apt-get install -y --no-install-recommends musl-tools \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add x86_64-unknown-linux-musl \
    && cargo build --locked --release \
      --target x86_64-unknown-linux-musl \
      --manifest-path proofs/settlement/host/Cargo.toml

FROM gcr.io/distroless/nodejs24-debian12@sha256:14d42e2511532589a7c7e01a753667a74fcc96266e137e8125006b87b0c32d0a AS runtime

ENV NODE_ENV=production \
    PATH=/opt/risc0/bin:${PATH}
WORKDIR /app

COPY --from=builder --chown=65532:65532 /root/.risc0/extensions/v2.2.0-cargo-risczero-x86_64-unknown-linux-gnu/r0vm /opt/risc0/bin/r0vm
COPY --from=builder --chown=65532:65532 /build/proofs/settlement/target/x86_64-unknown-linux-musl/release/layrs-settlement-proof-host /app/bin/layrs-settlement-proof-host
COPY --from=builder --chown=65532:65532 /build/proofs/settlement/worker/node_modules /app/worker/node_modules
COPY --from=builder --chown=65532:65532 /build/proofs/settlement/worker/core.mjs /app/worker/core.mjs
COPY --from=builder --chown=65532:65532 /build/proofs/settlement/worker/production.mjs /app/worker/production.mjs
COPY --from=builder --chown=65532:65532 /build/proofs/settlement/zkverify/node_modules /app/zkverify/node_modules
COPY --from=builder --chown=65532:65532 /build/proofs/settlement/zkverify/submit-proof.mjs /app/zkverify/submit-proof.mjs
USER 65532:65532

ENTRYPOINT ["/nodejs/bin/node", "/app/worker/production.mjs"]
